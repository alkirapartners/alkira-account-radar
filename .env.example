ANTHROPIC_API_KEY=sk-ant-REPLACE

SUPABASE_URL=https://REPLACE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE

RADAR_DAILY_BATCH_LIMIT=5
RADAR_MAX_BATCH_SIZE=40
RADAR_AGENT_CONCURRENCY=8

# Local development only: where `next dev` proxies /api/brief and /api/radar.
# In production nginx routes both paths itself.
BRIEF_API_INTERNAL=http://127.0.0.1:8501
RADAR_API_INTERNAL=http://127.0.0.1:8601
NEXT_PUBLIC_API_BASE=/api/radar

# Next.js prod port — brief-gen owns 3000 on the shared box.
PORT=3001
